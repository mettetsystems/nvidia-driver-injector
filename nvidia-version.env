# Authoritative NVIDIA source + userspace version for this branch.
# Dockerfile ARG NVIDIA_OPEN_TAG must match NVIDIA_OPEN_TAG here
# (enforced by tests/test-nvidia-version.sh).
#
# NVIDIA_OPEN_TAG        git tag of NVIDIA/open-gpu-kernel-modules and
#                        NVIDIA/nvidia-modprobe, and the .run bundle version.
# NVIDIA_DRIVER_VERSION  expected userspace / GSP firmware directory name.
#                        Must equal NVIDIA_OPEN_TAG. The injector module
#                        string (after A5) is ${NVIDIA_OPEN_TAG}-apnex.N.
NVIDIA_OPEN_TAG=610.57.04
NVIDIA_DRIVER_VERSION=610.57.04
